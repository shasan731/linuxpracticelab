{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Linux Practice Lab",
  "version": "0.1.0",
  "identifier": "com.linuxpracticelab.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Linux Practice Lab",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "theme": null,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src 'none'; object-src 'none'; base-uri 'self'",
      "freezePrototype": true,
      "assetProtocol": {
        "enable": false,
        "scope": []
      }
    },
    "withGlobalTauri": false
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Linux Practice Lab",
    "category": "Education",
    "shortDescription": "Practise real Linux on Windows",
    "longDescription": "Linux Practice Lab gives you a real, disposable Debian command line on Windows with a structured curriculum, no virtual machine setup and no administrator rights.",
    "copyright": "Distributed with QEMU under the GNU GPL version 2. See the licences directory.",
    "licenseFile": "../../../LICENSE",
    "resources": {
      "../../../lessons": "lessons/",
      "../../../runtime/bin/0.1.0": "runtime/0.1.0/"
    },
    "externalBin": [],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"],
        "displayLanguageSelector": false
      },
      "allowDowngrades": false
    }
  }
}
